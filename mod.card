-- Sharing metadata.  Read by tooling and the manager detail pane; never by
-- the loader's merge.
return {
  summary = "OPTIONS -> QOL TOGGLES submenu: poison survives at 1 HP, captures are fully healed with PP restored, an infinite repel, every learnable field move usable without knowing it (HM extras need the HM item), no badge gates, reusable TMs, forgettable HMs, always-catch, perfect DVs, selectable EXP and money multipliers (0x, 1.5x, 2x, 3x or 4x), Battle Palace-style auto battling from Gen 1 DVs and stat EXP, instant flee, a battle cursor that remembers where it was, no encounter dupes, instant fishing, post-battle heals, an auto turn-away after the nurse heals, a no-dialogue quick nurse, auto-refilling repels, bulk mart quantities, lit caves, a remembered fight move, blackouts that keep your money, auto-cut trees, hold-B running, a Gen 2-style battle EXP bar, and on-the-fly renaming from the party menu. Works on Red/Blue/Yellow and Gold.",
  author = "Shane",
  tags = { "quality-of-life", "options", "toggles" },
  differences = {
    changed = {
      "poisoned party members no longer faint from out-of-battle poison damage at 1 HP; their poison subsides with \"X's poison has subsided!\"",
      "a successful capture fully heals the Pokémon (HP, status, and all PP) whether it joins the party or goes to a PC box",
      "an INFINITE REPEL switch blocks all wild walking encounters while active",
      "a FIELD MOVES ALL switch lets every species that can learn a field move (level-up or TM/HM) use it out of battle even without knowing it; badge gates and context rules still apply",
      "a BADGELESS MOVES switch drops the badge gates for FLY/SURF/CUT/STRENGTH/FLASH in the party menu and at use time",
      "an HM ITEM REQUIRED switch keeps the FIELD MOVES ALL extras for HM moves off until the player holds the HM item (no CUT on the Cascade Badge alone when the HM is still on the S.S. Anne); moves a Pokémon already knows are never gated",
      "an UNLIMITED TMs switch keeps TMs after teaching their move",
      "a FORGETTABLE HMs switch lets HM moves be forgotten when a Pokémon learns a new move",
      "an ALWAYS CATCH switch makes every ball catch, Master Ball style",
      "a PERFECT DVS switch maxes the DVs of every caught Pokémon",
      "an EXP MULT switch scales battle EXP by a selectable multiplier (0x, 1.5x, 2x, 3x or 4x, stepping with A; fractions floor; 0x earns nothing) -- the old fixed EXP x2 toggle, with a save that already set it reading as 2x",
      "a MONEY MULT switch scales battle earnings the same way -- trainer prize money and Pay Day; the victory and \"picked up\" texts show the scaled figure, and at 0x the prize line is dropped entirely (no \"You got ¥0\" box) and Pay Day is cancelled",
      "an INSTANT FLEE switch escapes wild battles on the first try",
      "a REMEMBER CURSOR switch keeps the battle FIGHT/BAG/PKMN/RUN cursor where it was left across turns (OFF restores the fresh-FIGHT default each turn)",
      "a B FOR QUICK FLEE switch moves the battle menu cursor to RUN when B is pressed at the menu root (A still confirms the escape); it never fires in the old man's demo battle, a Safari battle, a trainer battle, or while a locked action owns the turn",
      "a HEAL ON MAP CHANGE switch fully heals the party (HP, status, PP) on every map transition",
      "a QUICK S.S. ANNE switch prompts the Vermilion dock sailor for the ticket once, then lets the player pass without dialogue",
      "a LAST ITEM (M) switch makes M in battle use the last item used from the bag",
      "a POKEBALL BONUS switch grants a free GREAT BALL for every ten POKé BALLS bought at any mart, announced by the clerk",
      "a NO ENCOUNTER DUPES switch re-rolls a wild encounter that repeats the last species (session-scoped, best effort)",
      "an INSTANT FISH switch makes the rod always bite on the first try, uniform-picking the map's fishing group",
      "a HEAL AFTER BATTLE switch fully heals the party (HP, status, PP) whenever a battle ends",
      "a TURN AWAY (NURSE) switch turns the player away from the counter after a Pokecenter heal, so mashing A walks off instead of re-talking to the nurse",
      "the field-move submenu keeps the cart's eight-row limit, so a mon that can learn more field moves than fit never pushes rows off the screen",
      "an AUTO-REPEL switch replaces a worn-off repel from the bag automatically, strongest first, announced by an on-screen toast",
      "a BULK MART switch opens mart quantity prompts at 10 for BUY and SELL",
      "a BULK COINS switch re-asks the Celadon Game Corner clerk's offer and lets him sell 50, 500 or 9,999 coins at a time, or any amount via a CUSTOM four-digit picker (digits 0-9)",
      "a LIGHTS ON switch renders dark caves and tunnels fully lit without FLASH",
      "a REMEMBER MOVE switch keeps the FIGHT move cursor on the last move used across turns",
      "a KEEP MONEY switch stops blackouts from halving the player's money",
      "an AUTO CUT switch cuts trees the player walks into when a party mon knows CUT",
      "a RUN (HOLD B) switch doubles foot speed while B is held, off the bike and off the surfboard",
      "a MOUSE CAM LOCK switch stops Dramatic Shape's battle camera following the mouse (stick, drag and zoom still work)",
      "an AUTO BATTLER switch makes the player's Pokémon choose moves in Battle Palace style, mapping Gen 1 DVs and stat EXP to an approximate Palace style; low HP latches until switch-out; an empty category falls back to a usable move instead of the Emerald 50% turn-skip, and out of PP the Pokémon Struggles like vanilla; disabling the toggle preserves the original action",
      "an EXP BAR switch renders a Gen 2-style EXP bar below the player's HP bar in battle, filling the arrow/underline groove in black as EXP is earned",
      "a MAP LOCATION switch toasts the name of the area when the player enters a new map, in the AUTO-REPEL banner style, with corrected names where the town map data lies (the Route 10 PokeCenter reads as ROCK TUNNEL there)",
      "a RENAME row in the party submenu opens the naming screen for the selected Pokémon so it can be renamed on the fly (the current name pre-fills; an empty or unchanged confirm keeps it); the row stays out of battle and off eggs, and when the eight-row submenu box is full the CANCEL row (then the last field-move row) gives up its seat so RENAME is always visible",
      "a QUICK NURSE switch skips all Pokecenter nurse dialogue -- no welcome, no yes/no, no farewell -- playing the heal machine animation and turning the player away automatically; the center is still remembered as the last-heal point, the Pewter Pikachu sleep scene keeps its vanilla dialogue, and on Gold the shared PokecenterNurseScript plays the heal machine special without running script dialogue",
      "a PARTY SCROLL switch allows pressing Up and Down on the STATS screen to cycle through party Pokémon without closing the screen, retaining the active page (Stats or Moves/EXP)",
      "an INSTANT TEXT switch types all dialogue and menus out at once instead of the engine's typewriter pace, overriding the TEXT SPEED setting; the down-arrow / page prompts still gate on A like the cart",
      "a HOLD TO SCROLL switch lets holding Up or Down keep stepping a menu instead of tapping per step (and Left/Right on the QOL TOGGLES card grid), covering the bag, shop, box and Pokédex lists, the generic menu boxes, the OPTIONS screen and the QOL TOGGLES submenu on Red and Gold",
      "an ANIM SKIP switch allows skipping battle animations, Pokémon cries, level up jingles, and overworld item get fanfares (e.g. Oak's Parcel) by pressing A, and force-stops prior sounds on audio overlap",
    },
    added = {
      "a QOL TOGGLES row in OPTIONS that opens a submenu with the toggles, persisted in options.lua",
    },
    known = {
      "On Gold, the Gen 1-cart-only toggles (QUICK S.S. ANNE, BULK COINS, LIGHTS ON, MOUSE CAM LOCK, LAST ITEM (M), AUTO BATTLER, EXP BAR, POKEBALL BONUS, BULK MART, FORGETTABLE HMs) do not appear in the submenu -- Gold's mart, battle-item and HM-forget APIs have no honest equivalent yet, and Gold already renders a native EXP bar in battle.  The rest behave the same on both generations",
      "REPEL does not affect fishing encounters (the engine's encounter.fishing path is untouched), matching the vanilla Repel item",
      "POISON SAVE, FULL HEAL CATCH, FIELD MOVES ALL, HM ITEM REQUIRED, UNLIMITED TMs, FORGETTABLE HMs, REMEMBER CURSOR, AUTO-REPEL, REMEMBER MOVE, MAP LOCATION, RENAME and PARTY SCROLL ship ON; the other thirty, including AUTO BATTLER, EXP BAR, INSTANT TEXT, HOLD TO SCROLL, B FOR QUICK FLEE and TURN AWAY (NURSE), ship OFF.  Toggles persist in options.lua, independent of save files",
      "INSTANT FISH leaves the rod's brief cast pause in place, and a map with no fishing group still has nothing to catch",
      "AUTO CUT only fires when a party mon knows CUT (FIELD MOVES ALL does not extend to it), and the step is consumed by the cut text + animation",
      "NO ENCOUNTER DUPES is session-scoped, so a restart forgets the last species",
    },
  },
  credits = {},
  compat = { engine = ">=0.1.53 <2.0.0", modApi = 2 },
}
